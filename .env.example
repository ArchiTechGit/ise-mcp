# Cisco ISE MCP Server Configuration

# Database Configuration
DATABASE_URL=postgresql://mcp_user:changeme@postgres:5432/ise_mcp
DB_PASSWORD=changeme

# Security Configuration
EDIT_MODE_ENABLED=false
ENCRYPTION_KEY=generate-using-fernet-key-generation

# Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8080
LOG_LEVEL=INFO

# Session Configuration
SESSION_SECRET_KEY=generate-random-secret-key
SESSION_TIMEOUT_MINUTES=30

# Optional: MCP API Token for remote access security
# MCP_API_TOKEN=your-secure-token-here

# =============================================================================
# Cisco ISE Connection
# =============================================================================
# ISE credentials are managed per-deployment via the Web UI.
# These env vars seed the default ISE deployment entry on first startup (optional).
#
# ISE_HOST_URL   - Base URL of the Primary PAN, INCLUDING the ERS port.
#                  ERS listens on TCP 9060, not 443 - a URL without the port
#                  will not reach the API.
# ISE_USERNAME   - ERS admin username. The account must belong to an
#                  "ERS Admin" (read/write) or "ERS Operator" (read-only) group.
# ISE_PASSWORD   - ERS admin password
# ISE_VERIFY_SSL - Set to true to enforce TLS certificate verification
# ISE_CTS_PORT   - Port serving the TrustSec (CTS) subset of the ERS API,
#                  which ISE publishes on 9063 rather than 9060. Requests to
#                  /ctsapi/ paths are re-pointed here automatically.
#                  Set to 0 to disable if a proxy serves both on one port.
# ISE_ADMIN_PORT - Port serving the ISE admin API family (/admin/API/...),
#                  which includes the API Service that enables or disables the
#                  Open API. This is the admin HTTPS port, normally 443.
#                  Set to 0 to disable the rewrite.
#
ISE_HOST_URL=https://192.168.1.1:9060
ISE_USERNAME=ersadmin
ISE_PASSWORD=
ISE_VERIFY_SSL=false
ISE_CTS_PORT=9063
ISE_ADMIN_PORT=443

# =============================================================================
# SSL/TLS Configuration (HTTPS)
# =============================================================================

# Certificate generation settings
# CERT_DAYS       - Certificate validity period in days (default: 365)
# CERT_CN         - Certificate Common Name (default: ise-mcp)
# CERT_ORG        - Certificate Organization (default: ISE MCP)
# CERT_SERVER_IP  - Your server's IP address (added to certificate SANs)
#                   IMPORTANT: Set this to your server's IP for browser access
CERT_DAYS=365
CERT_CN=ise-mcp
CERT_ORG=ISE MCP
CERT_SERVER_IP=192.168.1.213

# =============================================================================
# Service URLs (HTTPS)
# =============================================================================

# PostgreSQL port (host-side mapping)
# Unique per stack: nexus=15432, catalyst=15433, fmc=15434, vcenter=15435, ise=15436
POSTGRES_PORT=15436

# Web API (FastAPI/MCP) HTTPS endpoint
# Unique per stack: nexus=8444, catalyst=8445, fmc=8446, vcenter=8447, ise=8448
# External access: https://YOUR_SERVER_IP:8448
WEB_API_PORT=8448

# Internal HTTP port (container-to-container, not exposed externally)
# Unique per stack: nexus=7100, catalyst=7101, fmc=7102, vcenter=7103, ise=7104
INTERNAL_HTTP_PORT=7104

# Web UI (Next.js) HTTPS endpoint
# Unique per stack: nexus=7443, catalyst=7444, fmc=7445, vcenter=7446, ise=7447
# External access: https://YOUR_SERVER_IP:7447
WEB_UI_PORT=7447

# =============================================================================
# Notes
# =============================================================================
#
# ISE deployment credentials are managed via the Web UI.
# Configure ISE deployments at https://YOUR_SERVER_IP:7447/clusters after starting.
#
# MCP SSE endpoint for Claude Desktop:
#   https://YOUR_SERVER_IP:8448/mcp/sse
#
# Self-signed certificates will generate browser warnings on first access.
# Accept the certificate to continue.
#
# To regenerate certificates:
#   1. docker compose down
#   2. docker volume rm ise-mcp-certs
#   3. docker compose up --build
#
# ISE ERS prerequisites:
#   1. Administration > System > Settings > API Settings > ERS Settings
#      -> enable "ERS (Read/Write)" on the Primary PAN
#   2. Create an admin user in the "ERS Admin" group (read/write) or
#      "ERS Operator" group (read-only)
#   3. Ports by API family: ERS on TCP 9060, TrustSec (CTS) on TCP 9063,
#      and the admin family (/admin/API/...) on the admin HTTPS port (443).
#      The API Service operations need Super Admin rights, not just ERS Admin.
#
# ISE auth flow:
#   HTTP Basic authentication is replayed on every request - there is no
#   session token. Accept: application/json is always sent, otherwise ERS
#   responds with XML.
